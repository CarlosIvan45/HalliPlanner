<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/planner_background"
    android:fillViewport="true"
    android:paddingStart="24dp"
    android:paddingTop="26dp"
    android:paddingEnd="24dp"
    android:paddingBottom="26dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agenda"
            android:gravity="center"
            android:textColor="@color/planner_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSelectedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Reuniones del dia"
            android:gravity="center"
            android:textColor="@color/planner_muted"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/planner_line"
            app:strokeWidth="1dp">

            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:dateTextAppearance="@style/CalendarDateTextHalliPlanner"
                android:focusedMonthDateColor="@color/calendar_text"
                android:selectedDateVerticalBar="@color/planner_primary"
                android:showWeekNumber="false"
                android:unfocusedMonthDateColor="@color/planner_muted"
                android:weekDayTextAppearance="@style/CalendarWeekTextHalliPlanner"
                android:weekSeparatorLineColor="@color/planner_line" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Reuniones y bloqueos"
            android:textColor="@color/planner_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/meetingList"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/txtMeetingEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text="No hay reuniones para esta fecha."
            android:textColor="@color/planner_muted"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMeeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Planear reunion"
            app:icon="@android:drawable/ic_menu_my_calendar" />
    </LinearLayout>
</ScrollView>
