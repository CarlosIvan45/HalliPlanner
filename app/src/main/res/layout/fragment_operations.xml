<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/planner_background"
    android:fillViewport="true"
    android:paddingStart="24dp"
    android:paddingTop="44dp"
    android:paddingEnd="24dp"
    android:paddingBottom="26dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/planner_surface"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/planner_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_title_pastel"
                    android:padding="14dp"
                    android:text="Operaciones"
                    android:gravity="center"
                    android:textColor="@color/planner_text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtOperationSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Crea pozos, entrenamientos o reuniones internas y asigna ingenieros."
                    android:gravity="center"
                    android:textColor="@color/planner_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtOperationOpenCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@color/planner_surface"
                android:padding="14dp"
                android:text="Activas: 0"
                android:textColor="@color/planner_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtOperationEngineerCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@color/planner_surface"
                android:padding="14dp"
                android:text="Asignados: 0"
                android:textColor="@color/planner_text"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputOperationSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:hint="Buscar operaciones"
            android:inputType="textCapSentences" />

        <Spinner
            android:id="@+id/spinnerOperationStatusFilter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerOperationTypeFilter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <ListView
            android:id="@+id/operationList"
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:layout_marginTop="16dp"
            android:cacheColorHint="@android:color/transparent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp" />

        <TextView
            android:id="@+id/txtOperationEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text="Aun no hay operaciones registradas."
            android:textColor="@color/planner_muted"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddOperation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Crear operacion"
            app:icon="@android:drawable/ic_input_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportOperations"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Exportar reporte PDF"
            android:textColor="@color/planner_primary"
            app:icon="@android:drawable/ic_menu_save"
            app:strokeColor="@color/planner_primary" />
    </LinearLayout>
</ScrollView>
