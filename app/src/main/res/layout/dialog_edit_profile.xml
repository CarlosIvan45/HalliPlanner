<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/inputProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/inputProfileRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Rol"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/inputProfileDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Departamento"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/inputProfilePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Telefono"
            android:inputType="phone" />

        <EditText
            android:id="@+id/inputProfileLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Ubicacion"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/inputProfileCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Empresa"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/inputProfileBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Bio profesional"
            android:inputType="textMultiLine"
            android:minLines="3" />
    </LinearLayout>
</ScrollView>
