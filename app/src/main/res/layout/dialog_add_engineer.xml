<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/inputEngineerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del ingeniero"
            android:inputType="textCapWords" />

        <Spinner
            android:id="@+id/inputEngineerType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/inputEngineerSpecialty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Especialidad"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/inputEngineerEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Correo"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/inputEngineerPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Telefono"
            android:inputType="phone" />
    </LinearLayout>
</ScrollView>
